# Copy to .env for local runs. No real secrets here; this is local-only, synthetic-data configuration.
MOCK_BANK_DATABASE_URL=postgresql+psycopg://mockbank:mockbank-local@localhost:5432/mockbank
FAKE_KYC_CASES_DIR=evals/cases
# The onboarding service (docker compose sets these for you):
# ENVIRONMENT=dev                      # dev | test | qa | prod (qa and prod need ONBOARDING_TOKENS and SESSION_SECRET)
# DATABASE_URL=postgresql+psycopg://onboarding_app:onboarding-app-local@localhost:5432/onboarding
# KYC_BASE_URL=http://localhost:8002
# KYC_API_KEY=
# MOCK_BANK_URL=http://localhost:8001
# LLM_BACKEND=fake                     # fake | bedrock
# LLM_ENABLED=true                     # false is the kill switch: templates only
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=                    # a model id or a cross-region inference profile id
# PROMPT_LABEL=production              # Langfuse prompt label: production | staging
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# MAX_INFO_ROUNDS=2
# CHECKPOINT_RETENTION_DAYS=30
# ONBOARDING_TOKENS=[{"id":"officer-1","role":"officer","sha256":"<sha256 of the token>"}]
# SESSION_SECRET=
